<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImportBSMTTargets>true</ImportBSMTTargets>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GameDirectory Condition="!$(Configuration.EndsWith('1.45.1')) AND '$(GameDirectory)' == ''">$(BeatSaberDir)</GameDirectory>
    <GameDirectory Condition="$(Configuration.EndsWith('1.45.1'))">D:\BSManager\BSInstances\1.45.1</GameDirectory>
    <CopyPDB>false</CopyPDB>
    <DisableCopyToGame Condition="$(Configuration.EndsWith('1.45.1'))">false</DisableCopyToGame>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LATEST</DefineConstants>
    <Configurations>Debug-1.29.1;Release-1.29.1;Debug-1.34.2;Release-1.34.2;Debug-1.37.1;Release-1.37.1;Debug-1.39.0;Release-1.39.0;Debug-1.40.8;Release-1.40.8;Debug-1.44.1;Release-1.44.1;Debug-1.44.2;Release-1.44.2;Debug-1.45.0;Release-1.45.0;Debug-1.45.1;Release-1.45.1</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.EndsWith('1.45.0')) OR $(Configuration.EndsWith('1.45.1'))">
    <DefineConstants>$(DefineConstants);ASYNC_BEATMAP_LOADER_ONLY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.EndsWith('1.45.1'))">
    <DefineConstants>$(DefineConstants);BEATMAP_CALLBACK_TYPE_IDS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PluginId>CustomJSONData</PluginId>
    <PluginName>CustomJSONData</PluginName>
    <Author>Aeroluna</Author>
    <Version>2.7.0</Version>
    <Description>Lets mappers include arbitrary data in beatmaps, and lets modders access that data. Why did I make this? Good question.</Description>
  </PropertyGroup>
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(GameDirectory)\Libs\0Harmony.dll" />
    <Reference Include="AdditionalContentModel.Interfaces" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\AdditionalContentModel.Interfaces.dll" />
    <Reference Include="BeatmapCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatmapCore.dll" Publicize="true" />
    <Reference Include="Colors" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Colors.dll" Publicize="true" />
    <Reference Include="DataModels" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\DataModels.dll" Publicize="true" />
    <Reference Include="GameplayCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\GameplayCore.dll" />
    <Reference Include="HMLib" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMLib.dll" />
    <Reference Include="IPA.Loader" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\IPA.Loader.dll" />
    <Reference Include="Main" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Main.dll" Publicize="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDirectory)\Libs\Newtonsoft.Json.dll" />
    <Reference Include="Tweening" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Tweening.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks.Luna" Version="2.1.0" />
    <PackageReference Include="BSIPA.AssemblyPublicizer.MSBuild" Version="0.5.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LunaBSMod.Tasks" Version="1.1.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.354" />
  </ItemGroup>
</Project>
